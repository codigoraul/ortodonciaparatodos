---
import { Image } from 'astro:assets';
---

<!-- slider-area -->
<section id="home" class="slider-area slider-four fix p-relative">
    <div class="slider-active" style="background: #00173c;">
        <!-- Primer Slide -->
        <div class="single-slider slider-bg d-flex align-items-center" style="background-image: url('./assets/img/slider/slider-1.jpg');">
            <div class="container">
                <div class="row justify-content-start align-items-center">
                    <div class="col-lg-10 col-md-10">
                        <div class="slider-content s-slider-content slider-text-2 mt-20 text-left" style="max-width: 750px;">
                            <h2 data-animation="fadeInUp" data-delay=".4s" style="color: #003373;">Instalación de bracket metálicos</h2>                                
                            <h3 data-animation="fadeInUp" data-delay=".4s" style="color: #ED6C44;">Clínica dental ubicada en Temuco</h3>                             
                            <div class="slider-btn mt-20">     
                                <a href="./aranceles" class="btn ss-btn" data-animation="fadeInLeft" data-delay=".4s">Conoce nuestros planes</a>
                            </div>        
                        </div>
                    </div>
                </div>
            </div>
        </div>

        <!-- Segundo Slide -->
        <div class="single-slider slider-bg d-flex align-items-center" style="background-image: url('./assets/img/slider/slider-2.jpg');">
            <div class="container">
                <div class="row justify-content-start align-items-center">
                    <div class="col-lg-10 col-md-10">
                        <div class="slider-content s-slider-content slider-text-2 mt-20 text-left" style="max-width: 750px;">
                            <h2 data-animation="fadeInUp" data-delay=".4s" style="color: #003373;">Ortodoncia para todos</h2>      
                            <h3 data-animation="fadeInUp" data-delay=".4s" style="color: #ED6C44;">Mismo arancel para todas las personas</h3>                          
                            <p class="slider-p" style="max-width: 550px;" data-animation="fadeInUp" data-delay=".4s">
                                No hacemos diferencias según previsión, por lo que existe un arancel único para todos nuestros pacientes.
                            </p>     
                            <div class="slider-btn mt-20">     
                                <a href="https://6741b06af294b3ee72021da7f5d254f29122a29f.agenda.softwaredentalink.com/agenda" target="_blank" class="btn ss-btn" data-animation="fadeInLeft" data-delay=".4s">Agenda tu cita</a>
                            </div>        
                        </div>
                    </div>
                </div>
            </div>
        </div>

        <!-- Tercer Slide -->
        <div class="single-slider slider-bg d-flex align-items-center" style="background-image: url('./assets/img/slider/slider-3.jpg');">
            <div class="container">
                <div class="row justify-content-end align-items-center">
                    <div class="col-lg-10 col-md-10">
                        <div class="slider-content s-slider-content slider-text-2 mt-20 text-right" style="max-width: 790px; margin-left: auto;">
                            <h2 data-animation="fadeInUp" data-delay=".4s" style="color: #003373;">Clínica dental Temuco</h2>  
                            <h3 data-animation="fadeInUp" data-delay=".4s" style="color: #ED6C44;">Vanguardia y Calidad</h3>   
                            <p data-animation="fadeInUp" class="text-right" style="width: 450px" data-delay=".4s">
                                Utilizamos la última tecnología en ortodoncia para ofrecerte tratamientos más eficientes y cómodos.
                            </p>     
                            <div class="slider-btn mt-20">     
                                <a href="./nosotros" class="btn ss-btn" style="max-width: 430px;" data-animation="fadeInLeft" data-delay=".4s">Conoce Más</a>
                            </div>        
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
</section>

<style>
    .slider-area {
        position: relative;
        overflow: hidden;
    }

    .slider-bg {
        background-size: cover;
        background-position: center;
        background-repeat: no-repeat;
        min-height: 600px;
        position: relative;
    }

    .slider-bg::before {
        content: '';
        position: absolute;
        top: 0;
        left: 0;
        width: 100%;
        height: 100%;
        background: rgba(0, 0, 0, 0.3);
    }

    .slider-content {
        position: relative;
        z-index: 1;
    }

    .slider-content h2 {
        font-size: 62px;
        color: #003373;
    }

    .slider-content h3 {
        font-size: 36px;
        font-weight: 600;
        margin-bottom: 20px;
    }

    .slider-p {
        font-size: 18px;
        color: #fff;
        margin-bottom: 30px;
    }

    .ss-btn {
        display: inline-block;
        padding: 15px 30px;
        background: #ED6C44;
        color: #fff;
        border-radius: 5px;
        font-weight: 600;
        text-transform: uppercase;
        transition: all 0.3s ease;
    }

    .ss-btn:hover {
        background: #003373;
        color: #fff;
    }

    @media (max-width: 991px) {
        .slider-content h2 {
            font-size: 36px;
        }

        .slider-content h3 {
            font-size: 28px;
        }

        .slider-p {
            font-size: 16px;
        }
    }

    @media (max-width: 767px) {
        .slider-content h2 {
            font-size: 28px;
        }

        .slider-content h3 {
            font-size: 24px;
        }

        .slider-p {
            font-size: 14px;
        }

        .ss-btn {
            padding: 12px 25px;
            font-size: 14px;
        }
    }

    .slider-four .s-slider-content p {
        font-size: 20px;
        color: #424655;
        line-height: 26px;
        padding-bottom: 30px;
        width: 100%;
        margin: 0;
    }

    @media (max-width: 768px) {
        .slider-bg {
            min-height: 500px;
        }
        
        .slider-content h2 {
            font-size: 42px;
        }
    }
</style>

<script>
    // Preload de imágenes del slider
    document.addEventListener('DOMContentLoaded', () => {
        // Precargar la primera imagen inmediatamente
        const firstImage = new Image();
        firstImage.src = './assets/img/slider/slider-1.jpg';
        
        // Precargar las demás imágenes después de que la página esté lista
        window.addEventListener('load', () => {
            const images = [
                './assets/img/slider/slider-2.jpg',
                './assets/img/slider/slider-3.jpg'
            ];
            
            images.forEach(src => {
                const img = new Image();
                img.src = src;
            });
        });
    });
</script>
