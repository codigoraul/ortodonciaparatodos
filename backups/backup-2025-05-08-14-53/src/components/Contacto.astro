---
import emailjs from '@emailjs/browser';
---

<!-- contact-area -->
<section id="contact" class="contact-area after-none contact-bg pt-120 pb-120 p-relative fix">
    <div class="container">
        <div class="row justify-content-center align-items-center g-5">
            <div class="col-lg-5 order-2">
                <div class="contact-info">
                    <div class="contact_box_content style_one" data-aos="fade-up" data-aos-delay="0" data-aos-offset="0">
                        <div class="contact_box_inner icon_yes">
                            <div class="icon_bx">
                                <i class="fal fa-map-marker-alt"></i>
                            </div>
                            <div class="contnet">
                                <h3>Dirección</h3>
                                <p>Varas 989 piso 20, edificio Capital, Temuco</p>
                            </div>
                        </div>
                    </div>

                    <div class="contact_box_content style_one" data-aos="fade-up" data-aos-delay="100" data-aos-offset="0">
                        <div class="contact_box_inner icon_yes">
                            <div class="icon_bx">
                                <i class="fal fa-clock"></i>
                            </div>
                            <div class="contnet">
                                <h3>Horario de Atención</h3>
                                <p>Lunes a Viernes 09:00 a 18:30<br>
                                Sábado 09:00 a 13:00</p>
                            </div>
                        </div>
                    </div>

                    <div class="contact_box_content style_one" data-aos="fade-up" data-aos-delay="200" data-aos-offset="0">
                        <div class="contact_box_inner icon_yes">
                            <div class="icon_bx">
                                <i class="fal fa-envelope"></i>
                            </div>
                            <div class="contnet">
                                <h3>Contáctanos</h3>
                                <p>
                                    <a href="mailto:contacto@ortodonciaparatodos.cl">contacto@ortodonciaparatodos.cl</a><br>
                                    <a href="mailto:info@ortodonciaparatodos.cl">info@ortodonciaparatodos.cl</a>
                                </p>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
            <div class="col-lg-7 order-1">
                <div class="contact-bg02">
                    <div class="section-title center-align">
                        <h2>Formulario de Contacto</h2>
                    </div>
                    <form id="contact-form" class="contact-form mt-30">
                        <div class="row">
                            <div class="col-lg-12">
                                <div class="contact-field p-relative c-name mb-20">
                                    <input type="text" id="user_name" name="user_name" placeholder="Nombre" required>
                                </div>
                            </div>
                            <div class="col-lg-6">
                                <div class="contact-field p-relative c-subject mb-20">
                                    <input type="email" id="user_email" name="user_email" placeholder="Email" required>
                                </div>
                            </div>
                            <div class="col-lg-6">
                                <div class="contact-field p-relative c-subject mb-20">
                                    <input type="tel" id="user_phone" name="user_phone" placeholder="Teléfono" required>
                                </div>
                            </div>
                            
                            <div class="col-lg-12">
                                <div class="contact-field p-relative c-message mb-30">
                                    <textarea name="message" id="message" cols="30" rows="10" placeholder="Escribe tu mensaje"></textarea>
                                </div>
                                <div class="slider-btn">
                                    <button type="submit" class="btn ss-btn" data-animation="fadeInRight" data-delay=".8s">
                                        <span>Enviar Mensaje</span>
                                    </button>
                                </div>
                            </div>
                        </div>
                    </form>
                    <div id="success-message" class="alert alert-success mt-3" style="display: none;">
                        ¡Mensaje enviado con éxito! Nos pondremos en contacto contigo pronto.
                    </div>
                    <div id="error-message" class="alert alert-danger mt-3" style="display: none;">
                        Hubo un error al enviar el mensaje. Por favor, intenta nuevamente.
                    </div>
                </div>
            </div>
        </div>
    </div>
</section>

<style>
    .contact-area {
        background: #fff;
    }

    .contact-bg02 {
        background: #fff;
        padding: 40px;
        border-radius: 10px;
        box-shadow: 0 0 20px rgba(0,0,0,0.1);
    }

    .contact-field input,
    .contact-field textarea {
        width: 100%;
        height: 50px;
        background: #f5f5f5;
        border: none;
        padding: 15px 20px;
        border-radius: 5px;
        font-size: 16px;
        color: #333;
    }

    .contact-field textarea {
        height: 150px;
        resize: none;
    }

    .contact-field input:focus,
    .contact-field textarea:focus {
        outline: none;
        background: #f0f0f0;
    }

    .f-cta-icon {
        font-size: 40px;
        color: #3660d9;
        margin-bottom: 20px;
    }

    .single-cta h5 {
        font-size: 20px;
        margin-bottom: 10px;
        color: #333;
    }

    .single-cta p {
        margin-bottom: 0;
        color: #666;
    }

    .single-cta p a {
        color: #3660d9;
        text-decoration: none;
    }

    .single-cta p a:hover {
        color: #20386A;
    }

    .slider-btn {
        display: inline-block;
        margin-top: 20px;
        width: 100%;
    }

    .slider-btn .btn.ss-btn {
        background-image: -moz-linear-gradient(0deg, rgb(9,152,230) 0%, rgb(54,96,217) 100%);
        background-image: -webkit-linear-gradient(0deg, rgb(9,152,230) 0%, rgb(54,96,217) 100%);
        background-image: -ms-linear-gradient(0deg, rgb(9,152,230) 0%, rgb(54,96,217) 100%);
        color: #fff;
        padding: 15px 30px;
        border-radius: 5px;
        border: none;
        font-size: 16px;
        font-weight: 500;
        transition: all 0.3s ease;
        width: 100%;
        text-transform: uppercase;
        letter-spacing: 1px;
        position: relative;
        overflow: hidden;
        z-index: 1;
    }

    .slider-btn .btn.ss-btn:before {
        content: '';
        position: absolute;
        top: 0;
        left: 0;
        width: 100%;
        height: 100%;
        background-image: -moz-linear-gradient(0deg, rgb(54,96,217) 0%, rgb(9,152,230) 100%);
        background-image: -webkit-linear-gradient(0deg, rgb(54,96,217) 0%, rgb(9,152,230) 100%);
        background-image: -ms-linear-gradient(0deg, rgb(54,96,217) 0%, rgb(9,152,230) 100%);
        z-index: -1;
        transition: all 0.3s ease;
        opacity: 0;
    }

    .slider-btn .btn.ss-btn:hover:before {
        opacity: 1;
    }

    .slider-btn .btn.ss-btn:hover {
        transform: translateY(-2px);
        box-shadow: 0 5px 15px rgba(54, 96, 217, 0.3);
    }

    .map iframe {
        width: 100%;
        height: 450px;
        border: none;
    }

    .section-title h2 {
        font-size: 40px;
        font-weight: 600;
        color: #20386A;
        margin-bottom: 30px;
        text-align: center;
    }

    @media (max-width: 991px) {
        .order-1 {
            order: 2;
        }
        .order-2 {
            order: 1;
            margin-bottom: 30px;
        }
        .contact-bg02 {
            padding: 30px;
        }
    }

    /* Estilos para las nuevas cajas de contacto */
    .contact_box_content {
        margin-bottom: 30px;
        background: #fff;
        padding: 30px;
        border-radius: 10px;
        box-shadow: 0 0 20px rgba(0,0,0,0.1);
        transition: all 0.3s ease;
    }

    .contact_box_content:hover {
        transform: translateY(-5px);
    }

    .contact_box_inner {
        display: flex;
        align-items: flex-start;
        gap: 20px;
    }

    .icon_bx {
        width: 60px;
        height: 60px;
        background-image: -moz-linear-gradient(0deg, rgb(9,152,230) 0%, rgb(54,96,217) 100%);
        background-image: -webkit-linear-gradient(0deg, rgb(9,152,230) 0%, rgb(54,96,217) 100%);
        background-image: -ms-linear-gradient(0deg, rgb(9,152,230) 0%, rgb(54,96,217) 100%);
        border-radius: 50%;
        display: flex;
        align-items: center;
        justify-content: center;
        flex-shrink: 0;
    }

    .icon_bx i {
        color: #fff;
        font-size: 24px;
    }

    .contnet h3 {
        font-size: 20px;
        color: #20386A;
        margin-bottom: 10px;
        font-weight: 600;
    }

    .contnet p {
        margin: 0;
        color: #666;
        line-height: 1.6;
    }

    .contnet p a {
        color: #3660d9;
        text-decoration: none;
        transition: color 0.3s ease;
    }

    .contnet p a:hover {
        color: #20386A;
    }

    .alert {
        padding: 15px;
        border-radius: 5px;
        margin-top: 20px;
    }

    .alert-success {
        background-color: #d4edda;
        color: #155724;
        border: 1px solid #c3e6cb;
    }

    .alert-danger {
        background-color: #f8d7da;
        color: #721c24;
        border: 1px solid #f5c6cb;
    }

    .btn.ss-btn:disabled {
        opacity: 0.7;
        cursor: not-allowed;
    }
</style>

<script>
    // Cargar EmailJS
    import emailjs from '@emailjs/browser';

    document.addEventListener('DOMContentLoaded', function() {
        // Inicializar EmailJS con tu clave pública
        emailjs.init("Wnmz_tauG1p-dtmaF");

        const form = document.getElementById('contact-form') as HTMLFormElement;
        if (form) {
            form.addEventListener('submit', function(e) {
                e.preventDefault();
                
                // Obtener los valores del formulario
                const formData = {
                    name: (document.getElementById('user_name') as HTMLInputElement)?.value,
                    email: (document.getElementById('user_email') as HTMLInputElement)?.value,
                    phone: (document.getElementById('user_phone') as HTMLInputElement)?.value,
                    message: (document.getElementById('message') as HTMLTextAreaElement)?.value,
                    time: new Date().toLocaleString('es-CL', { 
                        year: 'numeric', 
                        month: 'long', 
                        day: 'numeric',
                        hour: '2-digit',
                        minute: '2-digit'
                    })
                };

                // Enviar el email usando EmailJS
                emailjs.send('service_raul4q', 'template_rd29wef', formData)
                    .then(function() {
                        // Mostrar mensaje de éxito
                        const successMessage = document.getElementById('success-message');
                        if (successMessage) successMessage.style.display = 'block';
                        
                        // Limpiar el formulario
                        form.reset();
                    })
                    .catch(function(error) {
                        // Mostrar mensaje de error específico
                        const errorMessage = document.getElementById('error-message');
                        if (errorMessage) {
                            errorMessage.textContent = `Error: ${error.text || error.message || 'Error desconocido'}`;
                            errorMessage.style.display = 'block';
                        }
                        console.error('Error detallado:', error);
                    });
            });
        }
    });
</script>

<!-- map-area -->
<div class="map fix" style="background: #f5f5f5;">
    <div class="container-flud">
        <div class="row">
            <div class="col-lg-12">
                <iframe src="https://www.google.com/maps/embed?pb=!1m18!1m12!1m3!1d3113.123456789012!2d-72.58912345678901!3d-38.73912345678901!2m3!1f0!2f0!3f0!3m2!1i1024!2i768!4f13.1!3m3!1m2!1s0x0%3A0x0!2zMzjCsDQ0JzIwLjgiUyA3MsKwMzUnMjAuNCJX!5e0!3m2!1ses!2scl!4v1234567890123!5m2!1ses!2scl" width="100%" height="450" style="border:0;" allowfullscreen="" loading="lazy"></iframe>
            </div>
        </div>
    </div>
</div>
<!-- map-area-end --> 