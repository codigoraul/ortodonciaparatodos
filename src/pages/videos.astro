---
import BaseLayout from '../layouts/BaseLayout.astro';
import PageHero from '../components/PageHero.astro';
import VideoCard from '../components/VideoCard.astro';
import { VIDEOS, SITE, isoDuration } from '../data/site';

const crumbs = [{ name: 'Videos', url: '/videos/' }];
const topics = ['Todos', ...Array.from(new Set(VIDEOS.map((v) => v.topic)))];
const schema = [{
  '@context': 'https://schema.org',
  '@type': 'ItemList',
  name: 'Videos educativos de ortodoncia y salud dental',
  itemListElement: VIDEOS.map((v, i) => ({
    '@type': 'ListItem',
    position: i + 1,
    item: {
      '@type': 'VideoObject',
      name: v.title,
      description: v.desc,
      thumbnailUrl: `${SITE.url}/videos/posters/${v.file}.jpg`,
      contentUrl: `${SITE.url}/videos/${v.file}.mp4`,
      uploadDate: '2025-03-10',
      duration: isoDuration(v.secs),
      inLanguage: 'es-CL',
      publisher: { '@id': `${SITE.url}/#clinica` },
    },
  })),
}];
import bgHero from '../assets/img/hero-ortodoncia-temuco.jpg';
import Icon from '../components/Icon.astro';
const IG_POST = 'https://www.instagram.com/p/DZDP8-rxXML/';
---
<BaseLayout
  title="Videos | Ortodoncia para Todos - Temuco"
  description="Videos informativos sobre tratamientos de ortodoncia, implantes, carillas y consejos dentales, explicados por los especialistas de Ortodoncia Para Todos en Temuco."
  breadcrumbs={crumbs}
  schema={schema}
>
  <PageHero image={bgHero} imagePosition="center 35%" eyebrow="Educación en video" title="Nuestros videos" lead="Nuestros especialistas explican tratamientos, cuidados y dudas frecuentes en videos breves y fáciles de entender." crumbs={crumbs} />

  <section class="section" style="padding-top:56px">
    <div class="container">
      <div class="filters" role="group" aria-label="Filtrar videos por tema" data-reveal>
        {topics.map((t, i) => <button type="button" data-filter={t} aria-pressed={i === 0 ? 'true' : 'false'}>{t}</button>)}
      </div>
      <div class="vgrid">
        {VIDEOS.map((v, i) => <div data-topic={v.topic}><VideoCard video={v} delay={(i % 4) * 0.05} /></div>)}
      </div>
    </div>
  </section>

  <section class="section section--ice ig">
    <div class="container ig__inner">
      <div class="ig__copy" data-reveal>
        <p class="eyebrow">Instagram</p>
        <h2>Síguenos en Instagram</h2>
        <p>Casos, consejos y novedades de la clínica. Mira nuestra última publicación y síguenos en <strong>@clinica_milenium</strong>.</p>
        <a href={SITE.social.instagram} target="_blank" rel="noopener" class="btn"><Icon name="instagram" />Seguir en Instagram</a>
      </div>
      <div class="ig__embed" data-reveal style="--d:.1s">
        <blockquote class="instagram-media" data-instgrm-permalink={`${IG_POST}?utm_source=ig_embed&utm_campaign=loading`} data-instgrm-version="14">
          <a href={IG_POST} target="_blank" rel="noopener">Ver esta publicación en Instagram</a>
        </blockquote>
      </div>
    </div>
  </section>
</BaseLayout>

<script>
  // Carga el script de Instagram solo cuando la sección se acerca a la pantalla
  const ig = document.querySelector('.ig');
  if (ig) {
    const load = () => { const sc = document.createElement('script'); sc.async = true; sc.src = 'https://www.instagram.com/embed.js'; document.body.appendChild(sc); };
    const io = new IntersectionObserver((e) => { if (e[0].isIntersecting) { load(); io.disconnect(); } }, { rootMargin: '400px' });
    io.observe(ig);
  }

  const btns = document.querySelectorAll<HTMLButtonElement>('[data-filter]');
  btns.forEach((b) => b.addEventListener('click', () => {
    btns.forEach((x) => x.setAttribute('aria-pressed', String(x === b)));
    const f = b.dataset.filter;
    document.querySelectorAll<HTMLElement>('[data-topic]').forEach((el) => {
      const hide = f !== 'Todos' && el.dataset.topic !== f;
      el.style.display = hide ? 'none' : '';
      if (hide) el.querySelectorAll('video').forEach((v) => v.pause());
    });
  }));
</script>

<style>
  .filters { display: flex; gap: 8px; flex-wrap: wrap; margin-bottom: 32px; }
  .filters button { padding: 10px 18px; border-radius: 999px; border: 1.5px solid var(--line); background: #fff; font-weight: 700; font-size: 0.92rem; color: var(--text-soft); transition: 0.25s; }
  .filters button:hover { border-color: var(--blue); color: var(--blue); }
  .filters button[aria-pressed='true'] { background: var(--navy); border-color: var(--navy); color: #fff; }
  .vgrid { display: grid; grid-template-columns: repeat(4, minmax(0, 1fr)); gap: 24px; }
  .vgrid > div { display: flex; }
  .vgrid > div > :global(*) { width: 100%; }
  .ig__inner { display: grid; grid-template-columns: 1fr 1fr; gap: clamp(32px, 5vw, 72px); align-items: center; }
  .ig__copy p:not(.eyebrow) { color: var(--text-soft); font-size: 1.08rem; margin-bottom: 24px; }
  .ig__embed { display: flex; justify-content: center; }
  .ig__embed :global(.instagram-media) { margin: 0 auto !important; max-width: 480px !important; width: 100% !important; border-radius: 18px !important; box-shadow: var(--shadow-lg) !important; }
  @media (max-width: 860px) { .ig__inner { grid-template-columns: 1fr; } }
  @media (max-width: 1024px) { .vgrid { grid-template-columns: repeat(3, minmax(0, 1fr)); } }
  @media (max-width: 760px) { .vgrid { grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 14px; } }
</style>
