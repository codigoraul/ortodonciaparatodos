---
import Layout from '../layouts/Layout.astro';

// Metadatos SEO
const seo = {
    title: "Videos | Ortodoncia para Todos - Temuco",
    description: "Videos informativos sobre tratamientos de ortodoncia, consejos dentales y testimonios de pacientes en Ortodoncia para Todos Temuco.",
    keywords: "videos ortodoncia, testimonios ortodoncia temuco, consejos dentales, tratamientos ortodoncia videos",
    canonical: "https://ortodonciaparatodos.cl/videos",
    ogTitle: "Videos | Ortodoncia para Todos - Temuco",
    ogDescription: "Videos informativos sobre tratamientos de ortodoncia y consejos dentales en Ortodoncia para Todos Temuco.",
    ogImage: "/img/og-image.jpg",
    ogUrl: "https://ortodonciaparatodos.cl/videos"
};
---

<Layout title={seo.title}>
    <!-- Meta tags para SEO -->
    <meta name="description" content={seo.description} />
    <meta name="keywords" content={seo.keywords} />
    <link rel="canonical" href={seo.canonical} />
    
    <!-- Open Graph / Facebook -->
    <meta property="og:type" content="website" />
    <meta property="og:url" content={seo.ogUrl} />
    <meta property="og:title" content={seo.ogTitle} />
    <meta property="og:description" content={seo.ogDescription} />
    <meta property="og:image" content={seo.ogImage} />
    
    <!-- Twitter -->
    <meta property="twitter:card" content="summary_large_image" />
    <meta property="twitter:url" content={seo.ogUrl} />
    <meta property="twitter:title" content={seo.ogTitle} />
    <meta property="twitter:description" content={seo.ogDescription} />
    <meta property="twitter:image" content={seo.ogImage} />

    <!-- Sección de Videos -->
    <section class="videos-section pt-120 pb-120">
        <div class="container">
            <div class="row">
                <div class="col-12 text-center mb-5">
                    <h1 class="section-title">Nuestros videos</h1>
                    <p class="section-description">
                        Descubre nuestros videos de Clinica dental Ortodoncia para Todos Temuco
                    </p>
                </div>
            </div>

            <div class="row">
                <!-- Video Card 1 -->
                <div class="col-lg-4 col-md-6 mb-4">
                    <div class="video-card">
                        <video 
                            src="/videos/video1.mp4"
                            controls
                            class="w-100"
                            title="Ortodoncia de ultima generación Ortodoncia Temuco"
                        ></video>
                        <div class="video-info">
                            <h3>Ortodoncia de ultima generación</h3>
                            <p>Conoce más sobre los tratamientos de ortodoncia y sus beneficios</p>
                        </div>
                    </div>
                </div>

                <!-- Video Card 2 -->
                <div class="col-lg-4 col-md-6 mb-4">
                    <div class="video-card">
                        <video 
                            src="/videos/video2.mp4"
                            controls
                            class="w-100"
                            title="Consejos para el Cuidado Dental"
                        ></video>
                        <div class="video-info">
                            <h3>Consejos para el Cuidado Dental</h3>
                            <p>Tips importantes para mantener una buena salud dental</p>
                        </div>
                    </div>
                </div>

                <!-- Video Card 3 - NUEVO VIDEO -->
                <div class="col-lg-4 col-md-6 mb-4">
                    <div class="video-card">
                        <video 
                            src="/videos/Ortodoncia-implantologia-periodoncia.mp4"
                            controls
                            class="w-100"
                            title="Ortodoncia, Implantología y Periodoncia - Ortodoncia Temuco"
                        ></video>
                        <div class="video-info">
                            <h3>Ortodoncia, Implantología y Periodoncia</h3>
                            <p>Descubre la relación entre estos tres campos fundamentales de la odontología</p>
                        </div>
                    </div>
                </div>

                <!-- Video Card 4 (antes era el 3) -->
                <div class="col-lg-4 col-md-6 mb-4">
                    <div class="video-card">
                        <video 
                            src="/videos/video3.mp4"
                            controls
                            class="w-100"
                            title="A la vanguardia en Ortodoncia"
                        ></video>
                        <div class="video-info">
                            <h3>A la vanguardia en Ortodoncia</h3>
                            <p>Conoce los ultimos avances en ortodoncia</p>
                        </div>
                    </div>
                </div>

                <!-- Video Card 5 (antes era el 4) -->
                <div class="col-lg-4 col-md-6 mb-4">
                    <div class="video-card">
                        <video 
                            src="/videos/video4.mp4"
                            controls
                            class="w-100"
                            title="Cerámica de una sesión Ortodoncia Temuco"
                        ></video>
                        <div class="video-info">
                            <h3>Cerámica de una sesión</h3>
                            <p>Fresado, cristalizado y glaseado, arenado, etc.</p>
                        </div>
                    </div>
                </div>

                <!-- Video Card 6 (antes era el 5) -->
                <div class="col-lg-4 col-md-6 mb-4">
                    <div class="video-card">
                        <video 
                            src="/videos/video5.mp4"
                            controls
                            class="w-100"
                            title="Tinción en cerámica dental Ortodoncia Temuco"
                        ></video>
                        <div class="video-info">
                            <h3>Tinción en cerámica dental</h3>
                            <p>Paso clave para una restauración estética natural y armoniosa</p>
                        </div>
                    </div>
                </div>

                <!-- Video Card 6 (antes era el 6) -->
                <div class="col-lg-4 col-md-6 mb-4">
                    <div class="video-card">
                        <video 
                            src="/videos/video6.mp4"
                            controls
                            class="w-100"
                            title="Cuanto duran los implantes Ortodoncia Temuco "
                        ></video>
                        <div class="video-info">
                            <h3>Cuanto duran los implantes </h3>
                            
                        </div>
                    </div>
                </div>
                <!-- Video 7 - Plano de barcelona, guia estetica para planificar tratamiento -->
                <div class="col-lg-4 col-md-6 mb-4">
                    <div class="video-card">
                        <video src="/videos/plano-de-barcelona.mp4" controls class="w-100" title="Plano de barcelona, guia estetica para planificar tratamiento"></video>
                        <div class="video-info">
                            <h3>Plano de barcelona</h3>
                            <p>Guia estetica para planificar tratamiento</p>
                        </div>
                    </div>
                </div>
                <!-- Video 8 - Dolor dental en la noche -->
                <div class="col-lg-4 col-md-6 mb-4">
                    <div class="video-card">
                        <video src="/videos/dolor-dental-en-la-noche.mp4" controls class="w-100" title="Dolor dental en la noche"></video>
                        <div class="video-info">
                            <h3>Dolor dental en la noche</h3>
                            <p>Conoce más sobre el dolor dental y cómo prevenirlo</p>
                        </div>
                    </div>
                </div>
                <!-- Video 9 - Tratamiento de la enfermedad periodontal --> 
                <div class="col-lg-4 col-md-6 mb-4">
                    <div class="video-card">
                        <video src="/videos/correccion-dental.mp4" controls class="w-100" title="Tratamiento de la enfermedad periodontal"></video>
                        <div class="video-info">
                            <h3>Ultima tecnologia en correccion dental</h3>
                            <p>Conoce más sobre la ultima tecnologia en correccion dental</p>
                        </div>
                    </div>
                </div>
            </div>
           

            <!-- Sección de Educación -->
            <div class="row mt-50">
                <div class="col-12 text-center">
                    <div class="education-section">
                        <h3><i class="fas fa-graduation-cap"></i> ¿Quieres aprender más sobre salud dental?</h3>
                        <p>Descubre nuestra sección de educación con información detallada sobre ortodoncia, cuidados bucales y prevención dental.</p>
                        <a href="/educacion" class="btn btn-education">Ver Educación Dental</a>
                    </div>
                </div>
            </div>
        </div>
    </section>

    <style>
        .videos-section {
            background-color: #f8f9fa;
            padding: 60px 0;
        }

        .section-title {
            color: #1b5ca4;
            margin-bottom: 1rem;
        }

        .section-description {
            color: #666;
            font-size: 1.1rem;
        }

        .video-card {
            background: #fff;
            border-radius: 10px;
            overflow: hidden;
            box-shadow: 0 0 20px rgba(0,0,0,0.1);
            margin-bottom: 30px;
        }

        .video-card video {
            width: 100%;
            display: block;
            background: #000;
        }

        .video-info {
            padding: 20px;
        }

        .video-info h3 {
            color: #1b5ca4;
            font-size: 1.2rem;
            margin-bottom: 10px;
        }

        .video-info p {
            color: #666;
            font-size: 0.9rem;
            margin-bottom: 0;
        }

        .w-100 {
            width: 100%;
        }

        /* Estilos para la sección de educación */
        .education-section {
            background: linear-gradient(135deg, #1b5ca4, #3aafdd);
            color: white;
            padding: 40px;
            border-radius: 15px;
            margin-top: 30px;
        }

        .education-section h3 {
            font-size: 1.8rem;
            margin-bottom: 15px;
        }

        .education-section h3 i {
            margin-right: 10px;
            font-size: 1.6rem;
        }

        .education-section p {
            font-size: 1.1rem;
            margin-bottom: 25px;
        }

        .btn-education {
            background: #fff;
            color: #1b5ca4;
            padding: 15px 30px;
            border-radius: 50px;
            font-weight: 600;
            text-decoration: none;
            display: inline-block;
            transition: all 0.3s ease;
            border: 2px solid #fff;
        }

        .btn-education:hover {
            background: transparent;
            color: #fff;
            transform: translateY(-2px);
        }
    </style>
</Layout> 