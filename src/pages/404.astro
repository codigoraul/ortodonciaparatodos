---
import BaseLayout from '../layouts/BaseLayout.astro';
import Icon from '../components/Icon.astro';
---
<BaseLayout title="Página no encontrada" description="La página que buscas no existe o fue movida." noindex>
  <section class="section nf">
    <div class="container">
      <p class="nf__code">404</p>
      <h1>Esta página no existe</h1>
      <p>Puede que el enlace haya cambiado con nuestro nuevo sitio. Te ayudamos a encontrar lo que buscas:</p>
      <div class="nf__links">
        <a href="/" class="btn"><Icon name="arrow" />Ir al inicio</a>
        <a href="/tratamientos/" class="btn btn--outline">Tratamientos</a>
        <a href="/aranceles/" class="btn btn--outline">Aranceles</a>
        <a href="/contacto/" class="btn btn--outline">Contacto</a>
      </div>
    </div>
  </section>
</BaseLayout>
<style>
  .nf { text-align: center; min-height: 60vh; display: grid; place-items: center; }
  .nf__code { font-size: clamp(6rem, 18vw, 11rem); font-weight: 800; letter-spacing: -0.06em; line-height: 1; margin: 0; background: linear-gradient(180deg, var(--blue), var(--ice)); -webkit-background-clip: text; background-clip: text; color: transparent; }
  .nf p { color: var(--text-soft); max-width: 52ch; margin-inline: auto; }
  .nf__links { display: flex; justify-content: center; gap: 12px; flex-wrap: wrap; margin-top: 28px; }
</style>
