---
import BaseLayout from '../layouts/BaseLayout.astro';
import PageHero from '../components/PageHero.astro';
import ContactBlock from '../components/ContactBlock.astro';
import Icon from '../components/Icon.astro';
import { SITE } from '../data/site';

const crumbs = [{ name: 'Contacto', url: '/contacto/' }];
const quick = [
  { icon: 'calendar', title: 'Agenda en línea', text: 'Disponible las 24 horas', href: SITE.agendaUrl, cta: 'Agendar', ext: true },
  { icon: 'whatsapp', title: 'WhatsApp', text: SITE.whatsapp.label, href: SITE.whatsapp.href, cta: 'Escribir', ext: true },
  { icon: 'phone', title: 'Teléfono', text: `${SITE.phones[0].label} · ${SITE.phones[1].label}`, href: SITE.phones[0].href, cta: 'Llamar', ext: false },
];
const schema = [{ '@context': 'https://schema.org', '@type': 'ContactPage', name: 'Contacto Ortodoncia Para Todos', url: `${SITE.url}/contacto/`, about: { '@id': `${SITE.url}/#clinica` } }];
---
<BaseLayout
  title="Contacto | Ortodoncia para Todos Temuco"
  description="Contáctanos en Ortodoncia Para Todos Temuco. Agenda tu cita en línea, por WhatsApp o teléfono. Ubicados en A. Varas 989, piso 20, Edificio Capital, Temuco."
  breadcrumbs={crumbs}
  schema={schema}
>
  <PageHero eyebrow="Contacto" title="Hablemos de tu sonrisa" lead="Estamos en A. Varas 989, piso 20, Edificio Capital, en el centro de Temuco. Elige el canal que más te acomode." crumbs={crumbs} />

  <section class="section section--ice" style="padding-top:56px">
    <div class="container">
      <ContactBlock title="Envíanos tu consulta" />
    </div>
  </section>
  <section class="section">
    <div class="container">
      <div class="grid grid-3 quick">
        {quick.map((q, i) => (
          <a href={q.href} target={q.ext ? '_blank' : undefined} rel={q.ext ? 'noopener' : undefined} class="card qcard" data-reveal style={`--d:${i * 0.07}s`}>
            <span class="icon-badge"><Icon name={q.icon} /></span>
            <div><h2>{q.title}</h2><p>{q.text}</p></div>
            <span class="link-arrow">{q.cta} <Icon name="arrow" /></span>
          </a>
        ))}
      </div>
    </div>
  </section>

</BaseLayout>

<style>
  .qcard { display: flex; flex-direction: column; gap: 4px; color: inherit; }
  .qcard:hover { color: inherit; }
  .qcard h2 { font-size: 1.2rem; margin: 0 0 4px; letter-spacing: -0.01em; }
  .qcard p { color: var(--text-soft); margin: 0 0 14px; }
</style>
