---
import Layout from '../layouts/Layout.astro';
import Slider from '../components/Slider.astro';
import Equipo from '../components/Equipo.astro';
// Welcome to Astro! Wondering what to do next? Check out the Astro documentation at https://docs.astro.build
// Don't want to use any of this? Delete everything in this file, the `assets`, `components`, and `layouts` directories, and start fresh.

// Metadatos SEO
const seo = {
    title: "Ortodoncia Temuco | Clínica Dental Ortodoncia para Todos",
    description: "Clínica dental especializada en ortodoncia en Temuco. Ofrecemos tratamientos de ortodoncia y atención dental general con los mejores profesionales. ¡Agenda tu cita hoy!",
    keywords: "ortodoncia temuco, clinica dental temuco, ortodoncia para todos, atencion dental general temuco, brackets temuco, invisalign temuco, dentista temuco",
    canonical: "https://ortodonciaparatodos.cl",
    ogTitle: "Ortodoncia Temuco | Clínica Dental Ortodoncia para Todos",
    ogDescription: "Clínica dental especializada en ortodoncia en Temuco. Tratamientos de ortodoncia y atención dental general con los mejores profesionales.",
    ogImage: "/img/og-image.jpg",
    ogUrl: "https://ortodonciaparatodos.cl"
};
---

<Layout title={seo.title}>
	<!-- Meta tags para SEO -->
	<meta name="description" content={seo.description} />
	<meta name="keywords" content={seo.keywords} />
	<link rel="canonical" href={seo.canonical} />
	
	<!-- Open Graph / Facebook -->
	<meta property="og:type" content="website" />
	<meta property="og:url" content={seo.ogUrl} />
	<meta property="og:title" content={seo.ogTitle} />
	<meta property="og:description" content={seo.ogDescription} />
	<meta property="og:image" content={seo.ogImage} />
	
	<!-- Twitter -->
	<meta property="twitter:card" content="summary_large_image" />
	<meta property="twitter:url" content={seo.ogUrl} />
	<meta property="twitter:title" content={seo.ogTitle} />
	<meta property="twitter:description" content={seo.ogDescription} />
	<meta property="twitter:image" content={seo.ogImage} />

	<Slider />
	<!-- about-area -->
	<section class="about-area about-p pt-120 pb-120 p-relative fix">
		<div class="container">
			<div class="row justify-content-center align-items-center">
				<div class="col-lg-6 col-md-12 col-sm-12">
					<div class="s-about-img p-relative wow fadeInLeft animated" data-animation="fadeInLeft" data-delay=".4s">
						<img 
							src="./img/nosotros/clinica-dental-temuco.png" 
							alt="Clínica Dental Temuco - Especialistas en Ortodoncia"
							class="img-fluid"
						/> 
						<div class="about-text second-about">
							<span>12</span>
							<p>Años de Experiencia</p>
						</div>  
					</div>
				</div>
				<div class="col-lg-6 col-md-12 col-sm-12">
					<div class="about-content s-about-content wow fadeInRight animated" data-animation="fadeInRight" data-delay=".4s">
						<div class="about-title second-title pb-25">  
							<h1 class="slide-right">Ortodoncia Temuco</h1> 
							<h5 class="slide-right">Bienvenidos a Ortodoncia para todos</h5>
							                                  
						</div>
						<p class="slide-right">Ortodoncia para Todos es una clínica dental ubicada en Temuco, especializada en 
							tratamientos de ortodoncia para pacientes de todas las edades. 
							Ofrecemos una variedad de servicios dentales incluyendo ortodoncia, 
							atención dental general y tratamientos estéticos. Nuestra clínica se destaca 
							por su equipo profesional y su compromiso con la atención personalizada, 
							utilizando tecnología de vanguardia para asegurar resultados óptimos en 
							cada tratamiento dental.</p>
					</div>
				</div>
			</div>
		</div>
	</section>
	<!-- about-area-end -->
	<Equipo />
</Layout>
