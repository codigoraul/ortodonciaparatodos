<style>
    .footer-bg {
        background: #00173c;
        position: relative;
        z-index: 1;
    }

    .footer-p {
        padding-top: 90px;
    }

    .footer-top {
        padding-bottom: 70px;
    }

    .footer-widget {
        margin-bottom: 30px;
    }

    .f-widget-title h2 {
        color: #fff;
        font-size: 24px;
        margin-bottom: 20px;
    }

    .footer-link p {
        color: #a2a2a2;
        margin-bottom: 20px;
    }

    .footer-link ul {
        list-style: none;
        padding: 0;
        margin: 0;
    }

    .footer-link ul li {
        margin-bottom: 10px;
    }

    .footer-link ul li a {
        color: #a2a2a2;
        transition: color 0.3s ease;
    }

    .footer-link ul li a:hover {
        color: #3660d9;
    }

    .f-contact ul {
        list-style: none;
        padding: 0;
        margin: 0;
    }

    .f-contact ul li {
        display: flex;
        align-items: center;
        margin-bottom: 15px;
        color: #a2a2a2;
    }

    .f-contact ul li i {
        width: 40px;
        height: 40px;
        min-width: 40px;
        background-image: -moz-linear-gradient(0deg, rgb(9,152,230) 0%, rgb(54,96,217) 100%);
        background-image: -webkit-linear-gradient(0deg, rgb(9,152,230) 0%, rgb(54,96,217) 100%);
        background-image: -ms-linear-gradient(0deg, rgb(9,152,230) 0%, rgb(54,96,217) 100%);
        line-height: 40px;
        color: #fff !important;
        text-align: center;
        border-radius: 50%;
        margin-right: 10px;
        display: flex;
        align-items: center;
        justify-content: center;
    }

    .copyright-wrap {
        border-top: 1px solid rgba(255, 255, 255, 0.1);
        padding: 20px 0;
    }

    .copy-text {
        color: #a2a2a2;
    }

    .copy-text a {
        color: #3660d9;
        transition: color 0.3s ease;
    }

    .copy-text a:hover {
        color: #fff;
    }

    .footer-social {
        text-align: right;
    }

    @media (max-width: 991px) {
        .footer-social {
            text-align: center;
            margin-top: 20px;
        }
        
        .copy-text {
            text-align: center;
            margin-bottom: 15px;
        }
    }

    .about-title h2 {
        font-size: 46px;
    }

    .about-title h5 {
        color: #ff6d3c !important;
    }
</style>