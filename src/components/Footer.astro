                                    </a>
                                </li>
                            </ul>
                        </div>
                    </div>
                </div>
                
            </div>
        </div>
    </div>
    <div class="copyright-wrap">
        <div class="container">
            <div class="row align-items-center">
                <div class="col-lg-4">
                  <div class="copy-text">
                    @ 2025 por <a href="https://diseñopaginas.cl/" target="_blank">diseñopaginas.cl</a>    
                    </div>
                </div>
                <div class="col-lg-4">          
                    
                </div>
                <div class="col-lg-4">
                </div>
            </div>
        </div>
    </div>
</footer>
<!-- footer-end -->


<style>
    .footer-bg {
        background: #00173c;
        position: relative;
        z-index: 1;
    }

    .footer-text p,
    .list-wrap li a,
    .f-contact ul li,
    .footer-social ul li a {
        font-size: 16px !important;
    }

    .copy-text {
        color: #a2a2a2;
        font-size: 14px !important;
    }

    .copy-text a,
    .copyright-wrap .copy-text a,
    .copyright-wrap .copy-text a[href] {
        color: #00afdd !important;
        font-size: 14px !important;
    }

    h4.fw-title {
        color: #fff;
        font-size: 20px;
        padding-bottom: 32px !important;
        font-weight: 600;
    }

    .footer-p {
        padding-top: 90px;
    }

    .footer-top {
        padding-bottom: 70px;
    }

    .footer-widget {
        margin-bottom: 30px;
    }

    .f-widget-title h2 {
        color: #fff;
        font-size: 24px;
        margin-bottom: 20px;
    }

    .footer-link p {
        color: #a2a2a2;
        margin-bottom: 20px;
    }

    .footer-link ul {
        list-style: none;
        padding: 0;
        margin: 0;
    }

    .footer-link ul li {
        margin-bottom: 10px;
    }

    .footer-link ul li a {
        color: #a2a2a2;
        transition: color 0.3s ease;
    }

    .footer-link ul li a:hover {
        color: #3660d9;
    }

    .f-contact ul {
        list-style: none;
        padding: 0;
        margin: 0;
    }

    .f-contact ul li {
        display: flex;
        align-items: center;
        margin-bottom: 15px;
        color: #a2a2a2;
        line-height: 1.8;
    }

    .f-contact ul li i {
        width: 40px;
        height: 40px;
        min-width: 40px;
        background-image: -moz-linear-gradient(0deg, #3aafdd 0%, #2559a1 100%);
        background-image: -webkit-linear-gradient(0deg, #3aafdd 0%, #2559a1 100%);
        background-image: -ms-linear-gradient(0deg, #3aafdd 0%, #2559a1 100%);
        line-height: 40px;
        color: #fff !important;
        text-align: center;
        border-radius: 50%;
        margin-right: 10px;
        display: flex;
        align-items: center;
        justify-content: center;
    }

    .f-contact ul li a {
        color: #fff;
        text-decoration: none;
        transition: color 0.3s ease;
    }

    .f-contact ul li a:hover {
        color: #76D4ED;
    }

    .copyright-wrap {
        border-top: 1px solid rgba(255, 255, 255, 0.1);
        padding: 20px 0;
    }

    .copy-text a {
        color: #3660d9;
        transition: color 0.3s ease;
    }

    .copy-text a:hover {
        color: #fff;
    }

    .footer-social {
        text-align: left;
        margin-top: 20px;
        display: flex;
        justify-content: flex-start;
        width: 100%;
    }

    .footer-social :global(ul) {
        margin: 0;
        padding: 0;
        list-style: none;
        display: flex;
        justify-content: flex-start;
        gap: 15px;
    }

    .footer-social :global(ul li a) {
        width: 40px;
        height: 40px;
        background: rgba(255,255,255,0.1);
        border-radius: 50%;
        display: flex;
        align-items: center;
        justify-content: center;
        color: #fff;
        transition: .3s;
    }

    .footer-social :global(ul li a:hover) {
        background: #ED6C44;
    }

    .about-title h2 {
        font-size: 46px;
    }

    .about-title h5 {
        color: #ff6d3c !important;
    }

    .footer-area {
        background: #00173c;
        padding: 80px 0 0;
        position: relative;
    }

    .footer-logo {
        margin-bottom: 20px;
    }

    .footer-logo img {
        max-width: 200px;
        height: auto;
    }

    .footer-text p {
        color: #fff;
        margin-bottom: 20px;
        line-height: 1.6;
    }

    .list-wrap {
        margin: 0;
        padding: 0;
        list-style: none;
    }

    .list-wrap li {
        margin-bottom: 10px;
    }

    .list-wrap li a {
        color: #a2a2a2;
        transition: all 0.3s ease;
        display: flex;
        align-items: center;
    }

    .list-wrap li a i {
        font-size: 12px;
        margin-right: 8px;
        transition: transform 0.3s ease;
    }

    .list-wrap li a:hover {
        color: #76D4ED;
        padding-left: 5px;
    }

    .list-wrap li a:hover i {
        transform: translateX(3px);
    }

    .footer-bottom {
        background: rgba(0,0,0,0.2);
        padding: 20px 0;
        margin-top: 50px;
    }

    .copyright-text p {
        color: #fff;
        margin: 0;
    }

    @media (max-width: 991px) {
        .footer-area {
            padding: 60px 0 0;
        }
    }

    @media (max-width: 767px) {
        .footer-area {
            padding: 40px 0 0;
        }

        .footer-widget {
            text-align: center;
        }

        .footer-social ul {
            justify-content: center;
        }

        .list-wrap li {
            display: flex;
            align-items: center;
            justify-content: center;
        }
    }

    .footer-widget {
        margin-bottom: 30px;
    }

    .footer-widget2 {
        padding: 0 15px;
    }

    @media (max-width: 991px) {
        .footer-widget2 {
            padding: 0;
        }
    }

    .footer-second-column {
        margin-left: 25px;
    }

    @media (max-width: 991px) {
        .footer-second-column {
            margin-left: 0;
        }
    }

    .whatsapp-link {
        display: inline-flex;
        align-items: center;
        color: #6EE489;
        text-decoration: none;
        transition: all 0.3s ease;
        gap: 8px;
        margin-top: 6px;
    }

    .whatsapp-link svg {
        width: 48px;
        height: 48px;
        fill: #6EE489;
        color: #6EE489;
    }

    .whatsapp-link span {
        font-size: 16px;
        font-weight: 500;
    }

    .whatsapp-link:hover {
        color: #5CD378;
        transform: translateY(-2px);
    }

    .whatsapp-link:hover svg {
        fill: #5CD378;
        color: #5CD378;
    }

    .map-btn {
        display: inline-flex;
        align-items: center;
        gap: 10px;
        text-decoration: none;
        font-weight: bold;
        color: #23262b;
        font-size: 1.2rem;
        background: none;
        border: none;
        cursor: pointer;
        padding: 0;
        transition: color 0.2s;
    }

    .map-btn:hover {
        color: #007491;
    }

    .map-icon {
        display: inline-block;
        vertical-align: middle;
    }
</style>