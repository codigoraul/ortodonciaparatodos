<!-- header-end -->

<script>
    // Script para el menú sticky
    window.addEventListener('scroll', function() {
        var header = document.querySelector('#header-sticky');
        if (header) {
            header.classList.toggle('sticky', window.scrollY > 0);
        }
    });
</script>

<style>
.btn.ss-btn {
    background: #3AAFDD;
    color: #fff;
    border: 2px solid #3AAFDD;
    padding: 12px 30px;
    border-radius: 4px;
    font-weight: 500;
    text-transform: uppercase;
    font-size: 16px !important;
    transition: all 0.3s ease;
}

.btn.ss-btn:hover {
    background: transparent;
    color: #3AAFDD;
    border-color: #3AAFDD;
}

.header-cta ul li i {
    margin-right: 10px;
    color: #76D4ED;
}

.main-menu ul li:hover > a {
    color: #02b3e2;
}

.main-menu ul li a, 
.header-cta ul li span, 
.header-social a {
    font-size: 17px !important;
}

.second-header-btn .btn {
    background: #3aafdd;
    box-shadow: 0px 10px 30px 0px rgba(58, 175, 221, 0.3);
    font-size: 16px !important;
    text-transform: uppercase;
    color: #fff;
    padding: 20px 30px;
    position: relative;
    border-radius: 4px;
    border: none;
    transition: all 0.3s ease;
}

.second-header-btn .btn:hover {
    background: #2d8cb3;
    transform: translateY(-2px);
}

.main-menu ul li a {
    display: block;
    color: #00173c;
    padding: 20px 0;
    font-weight: 500;
}

.main-menu ul li a::after {
    content: "+";
    margin-left: 10px;
    color: #1b59a0;
}

@media (max-width: 991px) {
    .main-menu ul li a,
    #mobile-menu ul li a,
    .mobile-menu ul li a {
        font-size: 16px !important;
    }
}
</style>