---
import { Image } from 'astro:assets';
import Icon from './Icon.astro';
import logo from '../assets/img/logo-ortodoncia-para-todos.png';
import milenium from '../assets/img/milenium-logo.png';
import { NAV, SITE } from '../data/site';

const path = Astro.url.pathname;
const isActive = (href: string) => (href === '/' ? path === '/' : path.startsWith(href) || (href === '/nosotros/' && path.startsWith('/especialistas')) || (href === '/contacto/' && ['/educacion', '/videos', '/preguntas-frecuentes'].some((p) => path.startsWith(p))));
---
<header class="site-header" data-header>
  <div class="container site-header__inner">
    <div class="brand-group">
      <a href="/" class="brand" aria-label={`${SITE.name} — Inicio`}>
        <Image src={logo} alt={`${SITE.name} — ${SITE.slogan}`} width={420} densities={[1, 2]} loading="eager" fetchpriority="high" class="brand__logo" />
      </a>
      <span class="brand-group__sep" aria-hidden="true"></span>
      <Image src={milenium} alt="Milenium Odontología Integral" width={180} densities={[1, 2]} loading="eager" class="brand__partner" />
    </div>

    <nav class="nav" aria-label="Principal">
      <ul class="nav__list">
        {NAV.map((item) => (
          <li class:list={['nav__item', { 'has-sub': item.children }]}>
            <a href={item.href} class:list={['nav__link', { 'is-active': isActive(item.href) }]} aria-current={isActive(item.href) ? 'page' : undefined}>
              {item.label}
              {item.children && <Icon name="chevron" size={16} class="nav__chev" />}
            </a>
            {item.children && (
              <div class:list={['sub', { 'sub--wide': item.children.length > 4 }]}>
                <ul>
                  {item.children.map((c) => (
                    <li>
                      <a href={c.href}>
                        <strong>{c.label}</strong>
                        {c.desc && <span>{c.desc}</span>}
                      </a>
                    </li>
                  ))}
                </ul>
              </div>
            )}
          </li>
        ))}
      </ul>
    </nav>

    <div class="header-cta">
      <a href={SITE.agendaUrl} target="_blank" rel="noopener" class="btn"><Icon name="calendar" />Agendar cita</a>
      <button class="burger" aria-label="Abrir menú" aria-expanded="false" aria-controls="mobile-menu" data-burger>
        <Icon name="menu" size={26} />
      </button>
    </div>
  </div>

</header>

<!-- Menú móvil fuera del header: el backdrop-filter del header atrapa elementos fixed -->
  <div class="mobile" id="mobile-menu" data-mobile hidden>
  <div class="mobile__panel">
    <div class="mobile__head">
      <div class="mobile__brands">
        <a href="/" aria-label={`${SITE.name} — Inicio`}><Image src={logo} alt={SITE.name} width={180} class="mobile__logo" /></a>
        <span class="brand-group__sep" aria-hidden="true"></span>
        <Image src={milenium} alt="Milenium Odontología Integral" width={120} densities={[1, 2]} class="mobile__partner" />
      </div>
      <button class="burger burger--close" aria-label="Cerrar menú" data-close><Icon name="close" size={26} /></button>
    </div>
    <ul class="mobile__list">
      {NAV.map((item) => (
        <li>
          {item.children ? (
            <details>
              <summary>{item.label}<Icon name="chevron" size={18} /></summary>
              <ul>
                {item.href !== item.children[0].href && <li><a href={item.href}>Ver todo</a></li>}
                {item.children.map((c) => <li><a href={c.href}>{c.label}</a></li>)}
              </ul>
            </details>
          ) : (
            <a href={item.href} aria-current={isActive(item.href) ? 'page' : undefined}>{item.label}</a>
          )}
        </li>
      ))}
    </ul>
    <div class="mobile__cta">
      <a href={SITE.agendaUrl} target="_blank" rel="noopener" class="btn btn--block"><Icon name="calendar" />Agendar evaluación</a>
      <a href={SITE.whatsapp.href} target="_blank" rel="noopener" class="btn btn--wa btn--block"><Icon name="whatsapp" />Escribir por WhatsApp</a>
      <a href={SITE.phones[0].href} class="mobile__phone"><Icon name="phone" size={18} />{SITE.phones[0].label}</a>
    </div>
  </div>
</div>


<script>
  const header = document.querySelector('[data-header]') as HTMLElement;
  const burger = document.querySelector('[data-burger]') as HTMLButtonElement;
  const mobile = document.querySelector('[data-mobile]') as HTMLElement;
  const close = document.querySelector('[data-close]') as HTMLButtonElement;

  const onScroll = () => header.classList.toggle('is-scrolled', window.scrollY > 40);
  onScroll();
  window.addEventListener('scroll', onScroll, { passive: true });

  const open = () => { mobile.hidden = false; requestAnimationFrame(() => mobile.classList.add('is-open')); burger.setAttribute('aria-expanded', 'true'); document.body.style.overflow = 'hidden'; };
  const shut = () => { mobile.classList.remove('is-open'); burger.setAttribute('aria-expanded', 'false'); document.body.style.overflow = ''; setTimeout(() => (mobile.hidden = true), 350); };
  burger?.addEventListener('click', open);
  close?.addEventListener('click', shut);
  mobile?.addEventListener('click', (e) => { if (e.target === mobile) shut(); });
  document.addEventListener('keydown', (e) => { if (e.key === 'Escape' && !mobile.hidden) shut(); });
</script>

<style>
  .site-header { position: sticky; top: 0; z-index: 100; background: rgb(255 255 255 / 0.86); backdrop-filter: saturate(1.6) blur(16px); -webkit-backdrop-filter: saturate(1.6) blur(16px); border-bottom: 1px solid transparent; transition: box-shadow 0.4s var(--ease), border-color 0.4s; }
  .site-header.is-scrolled { box-shadow: 0 10px 30px -18px rgb(10 40 78 / 0.35); border-color: var(--line); }
  .site-header__inner { display: flex; align-items: center; gap: 28px; min-height: var(--header-h); transition: min-height 0.4s var(--ease); }
  .is-scrolled .site-header__inner { min-height: 78px; }

  .brand-group { flex: none; display: flex; align-items: center; gap: 22px; }
  .brand { flex: none; display: block; }
  .brand-group__sep { width: 1px; align-self: stretch; margin: 18px 0; background: linear-gradient(to bottom, transparent, rgb(113 123 132 / 0.3), transparent); }
  .brand-group :global(.brand__partner) { height: 38px; width: auto; transition: height 0.4s var(--ease); }
  .is-scrolled .brand-group :global(.brand__partner) { height: 30px; }
  .brand :global(.brand__logo) { height: 81px; width: auto; transition: height 0.4s var(--ease); }
  .is-scrolled .brand :global(.brand__logo) { height: 58px; }

  .nav { margin-left: auto; }
  .nav__list { display: flex; gap: 2px; list-style: none; margin: 0; padding: 0; }
  .nav__item { position: relative; }
  .nav__link { display: inline-flex; align-items: center; gap: 4px; padding: 10px 13px; border-radius: 10px; color: var(--navy); font-weight: 600; font-size: 0.95rem; position: relative; transition: color 0.2s, background 0.2s; }
  .nav__link::after { content: ''; position: absolute; left: 13px; right: 13px; bottom: 4px; height: 2px; border-radius: 2px; background: var(--blue); transform: scaleX(0); transform-origin: left; transition: transform 0.35s var(--ease); }
  .nav__link:hover { color: var(--blue); background: var(--ice-50); }
  .nav__link.is-active { color: var(--blue); }
  .nav__link.is-active::after { transform: scaleX(1); }
  .nav__link :global(.nav__chev) { flex: none; transition: transform 0.3s var(--ease); }
  .has-sub:hover :global(.nav__chev), .has-sub:focus-within :global(.nav__chev) { transform: rotate(180deg); }

  .sub { position: absolute; top: calc(100% + 10px); left: 50%; translate: -50% 0; min-width: 280px; background: #fff; border: 1px solid var(--line); border-radius: 18px; box-shadow: var(--shadow-lg); padding: 10px; opacity: 0; visibility: hidden; transform: translateY(8px); transition: opacity 0.25s, transform 0.35s var(--ease), visibility 0.25s; }
  .sub::before { content: ''; position: absolute; inset: -12px 0 auto; height: 12px; }
  .sub--wide { min-width: 560px; }
  .sub ul { list-style: none; margin: 0; padding: 0; display: grid; gap: 2px; }
  .sub--wide ul { grid-template-columns: 1fr 1fr; }
  .sub a { display: grid; gap: 2px; padding: 12px 14px; border-radius: 12px; transition: background 0.2s; }
  .sub a:hover { background: var(--ice-50); }
  .sub strong { color: var(--navy); font-size: 0.94rem; }
  .sub span { color: var(--text-soft); font-size: 0.82rem; }
  .has-sub:hover .sub, .has-sub:focus-within .sub { opacity: 1; visibility: visible; transform: none; }

  .header-cta { display: flex; align-items: center; gap: 12px; }
  .burger { display: none; width: 48px; height: 48px; border-radius: 12px; border: 1.5px solid var(--line); background: #fff; color: var(--navy); place-items: center; }

  .mobile { position: fixed; inset: 0; z-index: 1000; background: rgb(6 26 52 / 0.5); backdrop-filter: blur(4px); opacity: 0; transition: opacity 0.3s; }
  .mobile.is-open { opacity: 1; }
  .mobile__panel { position: absolute; inset: 0 0 0 auto; width: min(420px, 100%); background: #fff; padding: 18px 20px 28px; overflow-y: auto; transform: translateX(100%); transition: transform 0.4s var(--ease); display: flex; flex-direction: column; }
  .mobile.is-open .mobile__panel { transform: none; }
  .mobile__head { display: flex; align-items: center; justify-content: space-between; margin-bottom: 18px; }
  .mobile__brands { display: flex; align-items: center; gap: 12px; }
  .mobile__brands .brand-group__sep { margin: 8px 0; }
  .mobile__head :global(.mobile__logo) { height: 56px; width: auto; }
  .mobile__head :global(.mobile__partner) { height: 26px; width: auto; }
  .burger--close { display: grid; }
  .mobile__list { list-style: none; margin: 0; padding: 0; border-top: 1px solid var(--line); }
  .mobile__list > li { border-bottom: 1px solid var(--line); }
  .mobile__list a, .mobile__list summary { display: flex; justify-content: space-between; align-items: center; padding: 15px 4px; color: var(--navy); font-weight: 700; font-size: 1.05rem; cursor: pointer; list-style: none; }
  .mobile__list summary::-webkit-details-marker { display: none; }
  .mobile__list details[open] summary :global(svg) { transform: rotate(180deg); }
  .mobile__list details ul { list-style: none; padding: 0 0 10px 12px; margin: 0; }
  .mobile__list details a { font-weight: 500; font-size: 0.98rem; padding: 9px 4px; color: var(--text-soft); }
  .mobile__cta { display: grid; gap: 10px; margin-top: auto; padding-top: 24px; }
  .mobile__phone { display: flex; justify-content: center; align-items: center; gap: 8px; font-weight: 700; padding: 8px; color: var(--navy); }

  @media (max-width: 1360px) { .site-header__inner { gap: 20px; } .nav__link { padding: 10px 10px; } }
  @media (max-width: 1240px) { .nav__link { padding: 10px 8px; font-size: 0.92rem; } .brand :global(.brand__logo) { height: 65px; } .brand-group { gap: 14px; } .brand-group :global(.brand__partner) { height: 30px; } .site-header__inner { gap: 16px; } }
  @media (max-width: 1100px) {
    .nav { display: none; }
    .burger { display: grid; }
    .header-cta { margin-left: auto; }
  }
  @media (max-width: 560px) {
    :root { --header-h: 76px; }
    .header-cta .btn { display: none; }
    .brand :global(.brand__logo) { height: 52px; }
    .is-scrolled .brand :global(.brand__logo) { height: 45px; }
    .brand-group { gap: 10px; }
    .brand-group__sep { margin: 10px 0; }
    .brand-group :global(.brand__partner), .is-scrolled .brand-group :global(.brand__partner) { height: 24px; }
    .is-scrolled .site-header__inner { min-height: 66px; }
  }
</style>
