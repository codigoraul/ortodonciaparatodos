---
import { Image } from 'astro:assets';
import Icon from '../Icon.astro';
import heroImg from '../../assets/img/hero-paciente-ortodoncia.jpg';
import { SITE } from '../../data/site';
---
<section class="hero" aria-labelledby="hero-title">
  <!-- Foto abierta a la derecha, fundida en degradado con el fondo (como la muestra) -->
  <div class="hero__media">
    <Image src={heroImg} alt="Paciente joven sonriendo en el sillón dental de Ortodoncia Para Todos en Temuco" widths={[760, 1100, 1500, 1800]} sizes="(max-width: 900px) 100vw, 62vw" loading="eager" fetchpriority="high" class="hero__img" />
    <p class="hand note note--top" aria-hidden="true">Sonrisas que<br />cambian historias
      <svg viewBox="0 0 120 24"><path d="M4 16 C 30 4, 70 26, 116 8" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" /></svg>
    </p>
    <p class="hand note note--bottom" aria-hidden="true">Más que<br />ortodoncia,<br />personas
      <svg viewBox="0 0 120 24"><path d="M4 16 C 30 4, 70 26, 116 8" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" /></svg>
    </p>
  </div>

  <div class="container hero__inner">
    <div class="hero__copy">
      <h1 id="hero-title">
        <span class="kw">Ortodoncia en Temuco</span>
        <span class="line">Tu sonrisa<span class="punct">,</span></span>
        <span class="line line--blue">nuestro propósito<span class="punct">.</span></span>
      </h1>
      <p class="hero__lead">Ortodoncia especializada para <strong>niños, adolescentes y adultos</strong> en Temuco, con precios transparentes y el <strong>mismo arancel para todos</strong>.</p>

      <ul class="hero__features">
        <li><span><Icon name="tooth" /></span>Sonrisas que<br />cambian historias</li>
        <li><span><Icon name="users" /></span>Atención<br />personalizada</li>
        <li><span><Icon name="heart" /></span>Confianza en<br />cada etapa</li>
      </ul>

      <div class="hero__ctas">
        <a href={SITE.agendaUrl} target="_blank" rel="noopener" class="btn"><Icon name="calendar" />Agendar evaluación</a>
        <a href="/tratamientos/" class="btn btn--outline">Conoce nuestros tratamientos</a>
      </div>
    </div>
  </div>
</section>

<style>
  .hero { position: relative; overflow: hidden; isolation: isolate; min-height: clamp(560px, 44vw, 660px); display: flex; align-items: center; padding: clamp(48px, 5vw, 72px) 0 clamp(130px, 11vw, 160px); background: linear-gradient(100deg, #ffffff 0%, #f2f8fc 35%, #dcebf7 100%); }

  .hero__media { position: absolute; top: 0; right: 0; bottom: 0; width: 62%; z-index: -1; }
  .hero__media :global(.hero__img) { width: 100%; height: 100%; object-fit: cover; object-position: 74% 25%; }
  /* Degradado: la foto se funde hacia la izquierda y hacia abajo */
  .hero__media::before { content: ''; position: absolute; inset: 0; z-index: 1; pointer-events: none; background:
      linear-gradient(90deg, #f4f9fd 0%, rgb(244 249 253 / 0.92) 14%, rgb(244 249 253 / 0.55) 30%, rgb(244 249 253 / 0) 52%),
      linear-gradient(0deg, #ffffff 0%, rgb(255 255 255 / 0) 30%),
      linear-gradient(180deg, rgb(218 235 245 / 0.35) 0%, rgb(218 235 245 / 0) 25%); }
  /* Tono azulado suave sobre la foto, como la muestra */
  .hero__media::after { content: ''; position: absolute; inset: 0; z-index: 1; pointer-events: none; background: radial-gradient(80% 90% at 100% 20%, rgb(15 100 193 / 0.12), transparent 70%); }

  .note { position: absolute; z-index: 2; margin: 0; color: var(--navy); font-size: clamp(1.4rem, 1.7vw, 1.75rem); line-height: 1; text-align: center; text-shadow: 0 0 10px #fff, 0 0 18px #fff, 0 0 4px #fff; }
  .note svg { width: 110px; margin: 4px auto 0; color: var(--blue); display: block; }
  .note--top { right: 2.5%; top: 7%; transform: rotate(-8deg); color: #1f5fa8; }
  .note--bottom { right: 2.5%; bottom: 30%; transform: rotate(-10deg); }

  .hero__inner { position: relative; }
  .hero__copy { max-width: 660px; }

  h1 { font-size: clamp(2.4rem, 4.6vw, 4.3rem); line-height: 1.02; letter-spacing: -0.04em; margin-bottom: 22px; }
  .punct { margin-left: -0.08em; }
  .kw { display: block; font-size: clamp(0.82rem, 1vw, 0.95rem); font-weight: 800; letter-spacing: 0.16em; text-transform: uppercase; color: var(--blue); line-height: 1.3; margin-bottom: 14px; animation: up 1s var(--ease) both; }
  .line { display: block; animation: up 1s var(--ease) both; }
  .line--blue { color: var(--blue); animation-delay: 0.08s; }
  .hero__lead { font-size: clamp(1.1rem, 1.5vw, 1.3rem); color: #3a4b5e; max-width: 36ch; line-height: 1.5; margin-bottom: 32px; animation: up 1s var(--ease) 0.16s both; }
  .hero__lead strong { color: var(--navy); }

  .hero__features { list-style: none; margin: 0 0 36px; padding: 0; display: flex; gap: 22px; flex-wrap: wrap; animation: up 1s var(--ease) 0.24s both; }
  .hero__features li { display: flex; align-items: center; gap: 12px; font-size: 0.92rem; font-weight: 600; color: var(--navy); line-height: 1.3; }
  .hero__features li > span { width: 50px; height: 50px; border-radius: 50%; display: grid; place-items: center; background: #fff; color: var(--blue); box-shadow: var(--shadow); flex: none; }
  .hero__features li > span :global(svg) { width: 26px; height: 26px; }

  .hero__ctas { display: flex; gap: 14px; flex-wrap: wrap; animation: up 1s var(--ease) 0.32s both; }
  .hero__ctas .btn { min-height: 56px; padding: 0 26px; text-transform: uppercase; letter-spacing: 0.04em; font-size: 0.9rem; }

  @keyframes up { from { opacity: 0; transform: translateY(24px); } to { opacity: 1; transform: none; } }

  @media (max-width: 1100px) { .hero__copy { max-width: 520px; } .note--top { display: none; } }
  @media (max-width: 900px) {
    .hero { display: block; min-height: 0; padding-top: 0; }
    .hero__media { position: relative; width: 100%; height: 380px; }
    .hero__media::before { background: linear-gradient(0deg, #f4f9fd 0%, rgb(244 249 253 / 0) 45%); }
    .hero__media :global(.hero__img) { object-position: 72% 20%; }
    .note--bottom { bottom: 18%; font-size: 1.5rem; }
    .hero__inner { margin-top: -24px; }
    .hero__lead { max-width: 46ch; }
  }
  @media (max-width: 560px) {
    .hero__media { height: 300px; }
    .note--bottom { display: none; }
    .hero__features { gap: 14px; }
    .hero__features li { font-size: 0.84rem; }
    .hero__features li > span { width: 42px; height: 42px; }
    .hero__ctas .btn { width: 100%; }
  }
</style>
