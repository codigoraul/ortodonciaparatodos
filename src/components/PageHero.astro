---
import { Image } from 'astro:assets';
import Icon from './Icon.astro';
import type { ImageMetadata } from 'astro';
import defaultBg from '../assets/img/slider-3.jpg';

interface Props {
  eyebrow?: string;
  title: string;
  lead?: string;
  crumbs: { name: string; url: string }[];
  /** Imagen de fondo del encabezado (si no se indica, usa la sala de la clínica) */
  image?: ImageMetadata;
  imageAlt?: string;
  imagePosition?: string;
}
// eyebrow, lead y contenido extra se aceptan por compatibilidad pero no se muestran (encabezado compacto)
const { title, crumbs, image = defaultBg, imagePosition = 'center' } = Astro.props;
---
<section class="phero">
  <div class="phero__bg" aria-hidden="true">
    <Image src={image} alt="" widths={[768, 1280, 1920]} sizes="100vw" loading="eager" fetchpriority="high" style={`object-position:${imagePosition}`} />
  </div>
  <div class="container phero__inner">
    <nav aria-label="Ruta de navegación" class="crumbs">
      <ol>
        <li><a href="/">Inicio</a></li>
        {crumbs.map((c, i) => (
          <li>
            <Icon name="chevron" size={14} class="crumbs__sep" />
            {i === crumbs.length - 1 ? <span aria-current="page">{c.name}</span> : <a href={c.url}>{c.name}</a>}
          </li>
        ))}
      </ol>
    </nav>
    <h1>{title}</h1>
  </div>
</section>

<style>
  /* Alto del encabezado: ajustar --phero-h para hacerlo más alto o más bajo */
  .phero { --phero-h: 280px; position: relative; overflow: hidden; isolation: isolate; min-height: var(--phero-h); display: flex; align-items: center; padding: 28px 0; color: #d6e4f2; background: var(--navy); }
  .phero__bg { position: absolute; inset: 0; z-index: -1; }
  .phero__bg :global(img) { width: 100%; height: 100%; object-fit: cover; }
  /* Degradado azul de marca sobre la foto para dar contraste al texto */
  .phero__bg::after { content: ''; position: absolute; inset: 0; background:
      linear-gradient(90deg, rgb(10 40 78 / 0.94) 0%, rgb(10 40 78 / 0.82) 38%, rgb(15 100 193 / 0.45) 75%, rgb(15 100 193 / 0.25) 100%),
      linear-gradient(0deg, rgb(10 40 78 / 0.35), transparent 60%); }
  .phero__inner { position: relative; width: 100%; }
  @media (max-width: 760px) { .phero { --phero-h: 190px; } }

  .phero h1 { color: #fff; font-size: clamp(1.4rem, 2.2vw, 1.9rem); margin: 0; max-width: 32ch; letter-spacing: -0.02em; }

  .crumbs ol { list-style: none; display: flex; flex-wrap: wrap; align-items: center; gap: 6px; margin: 0 0 8px; padding: 0; font-size: 0.82rem; font-weight: 600; }
  .crumbs li { display: flex; align-items: center; gap: 6px; }
  .crumbs a { color: #b7cbe0; }
  .crumbs a:hover { color: #fff; }
  .crumbs span { color: #fff; }
  .crumbs :global(.crumbs__sep) { transform: rotate(-90deg); color: #7e9bbb; }
</style>
