---
import Icon from './Icon.astro';
import { SITE } from '../data/site';
---
<div class="topbar">
  <div class="container topbar__inner">
    <ul class="topbar__info">
      <li><a href={SITE.mapsUrl} target="_blank" rel="noopener"><Icon name="pin" size={16} />A. Varas 989, {SITE.city}</a></li>
      <li>
        <Icon name="phone" size={16} />
        <a href={SITE.phones[0].href}>{SITE.phones[0].label}</a>
        <span class="sep" aria-hidden="true">|</span>
        <a href={SITE.phones[1].href}>{SITE.phones[1].label}</a>
      </li>
    </ul>
    <div class="topbar__social">
      <span class="topbar__tag">Arancel único · Fonasa, Isapre y particular</span>
      <a href={SITE.social.instagram} target="_blank" rel="noopener" aria-label="Instagram"><Icon name="instagram" size={18} /></a>
      <a href={SITE.social.facebook} target="_blank" rel="noopener" aria-label="Facebook"><Icon name="facebook" size={18} /></a>
    </div>
  </div>
</div>

<style>
  .topbar { background: var(--navy); color: #c9d8ea; font-size: 0.84rem; }
  .topbar__inner { display: flex; align-items: center; justify-content: space-between; gap: 16px; min-height: 42px; }
  .topbar__info { display: flex; gap: 28px; list-style: none; margin: 0; padding: 0; align-items: center; }
  .topbar__info li { display: flex; align-items: center; gap: 8px; }
  .topbar a { color: #dbe7f4; display: inline-flex; align-items: center; gap: 8px; transition: color 0.2s; }
  .topbar a:hover { color: #fff; }
  .topbar :global(svg) { color: #7fb6ef; flex: none; }
  .sep { opacity: 0.35; }
  .topbar__social { display: flex; align-items: center; gap: 14px; }
  .topbar__tag { font-size: 0.78rem; font-weight: 600; color: #9fc4ea; padding-right: 14px; border-right: 1px solid rgb(255 255 255 / 0.15); }
  .topbar__social a :global(svg) { color: #fff; }
  @media (max-width: 1180px) { .topbar__tag { display: none; } }
  @media (max-width: 980px) { .hide-md { display: none !important; } }
  @media (max-width: 760px) { .topbar { display: none; } }
</style>
