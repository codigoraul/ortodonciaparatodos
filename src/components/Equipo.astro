---
     <!-- team-area -->
     <section class="team-area2 fix p-relative pt-40 pb-80">  
        <div class="container">  
            <div class="row">   
                <div class="col-lg-12 p-relative">
                   <div class="section-title center-align mb-20 text-center wow fadeInDown animated" data-animation="fadeInDown" data-delay=".4s">
                       <h5>Nuestro Equipo</h5>
                        <h2>Expertos en Ortodoncia</h2>
                    </div>
                </div>                        
            </div>
           <div class="row">                   
                {equipo.map((miembro) => (
                    <div class="col-xl-3">
                        <div class="single-team mb-40">
                            <div class="team-thumb">
                                <div class="brd">
                                     <Image src={miembro.imagen} alt={miembro.alt} class="img-fluid" />
                                </div>
                            </div>
                            <div class="team-info">
                                <h4>{miembro.nombre}</h4>
                                <p>{miembro.cargo}</p>
                            </div>
                        </div>
                    </div>
                ))}
            </div>
        </div>
        <div class="container">
            <div class="row">
                {equipo2.map((miembro) => (
                    <div class="col-xl-3">
                        <div class="single-team mb-40">
                            <div class="team-thumb">
                                <Image src={miembro.imagen} alt={miembro.alt} class="img-fluid" />
                            </div>
                            <div class="team-info">
                                <h4>{miembro.nombre}</h4>
                                <p>{miembro.cargo}</p>
                            </div>
                        </div>
                    </div>
                ))}
            </div>
        </div>
    </section>
   
<style>
    .team-thumb {
        position: relative;
        overflow: hidden;
        border-radius: 8px;
    }

    .team-thumb .brd {
        position: relative;
        overflow: hidden;
        border-radius: 8px;
    }

    .team-thumb img {
        transition: transform 0.5s ease;
        border-radius: 8px;
    }

    .single-team:hover .team-thumb img {
        transform: scale(1.1);
    }

    .team-thumb::after {
        content: '';
        position: absolute;
        top: 0;
        left: 0;
        width: 100%;
        height: 100%;
        background: linear-gradient(to bottom, rgba(0,0,0,0) 0%, rgba(0,0,0,0.2) 100%);
        opacity: 0;
        transition: opacity 0.3s ease;
    }

    .single-team:hover .team-thumb::after {
        opacity: 1;
    }

    .single-team {
        transition: transform 0.3s ease, box-shadow 0.3s ease;
    }

    .single-team:hover {
        transform: translateY(-5px);
        box-shadow: none;
    }

    .team-info {
        padding: 20px 0;
    }

    .team-info h4 {
        margin-bottom: 5px;
        transition: color 0.3s ease;
        color: #fff;
    }
</style> 