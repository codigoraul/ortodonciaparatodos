---
interface Props {
    title: string;
    subtitle?: string;
    currentPage: string;
    parentPage?: string;
    parentUrl?: string;
}

const { title, subtitle, currentPage, parentPage, parentUrl } = Astro.props;
---
<!-- breadcrumb-area -->
<section class="breadcrumb-area d-flex align-items-center" style="background-image:url(/assets/img/bg-title.png)">
    <div class="container">
        <div class="row align-items-center">
            <div class="col-xl-12 col-lg-12">
                <div class="breadcrumb-wrap text-left">
                    <div class="breadcrumb-title">
                        <h2>{title}</h2>    
                        <div class="breadcrumb-wrap">
                  
                    <nav aria-label="breadcrumb">
                        <ol class="breadcrumb">
                            <li class="breadcrumb-item"><a href="index.html">Inicio</a></li>
                            <li class="breadcrumb-item active" aria-current="page">{title}</li>
                        </ol>
                    </nav>
                </div>
                    </div>
                </div>
            </div>
            
        </div>
    </div>
</section>
<!-- breadcrumb-area-end -->

<style>
    :global(h2) {
        color: #003373;
    }
    .breadcrumb-area {
        background-size: cover;
        background-position: center 27%;
        position: relative;
        min-height: 192px;
        padding: 30px 0;
    }
    .breadcrumb {
        margin: 0;
        padding: 0;
        list-style: none;
        display: flex;
        flex-wrap: wrap;
    }
    .breadcrumb-item {
        display: flex;
        align-items: center;
        font-size: 16px;
    }
    .breadcrumb-item + .breadcrumb-item::before {
        content: "/";
        padding: 0 8px;
        color: #6c757d;
    }
    .breadcrumb-item a {
        color: #3aafdd;
        text-decoration: none;
        transition: color 0.3s ease;
        font-size: 16px;
    }
    .breadcrumb-item a:hover {
        color: #2d8cb3;
    }
    .breadcrumb-item.active {
        color: #6c757d;
        font-size: 16px;
    }
    .breadcrumb-title h2 {
        color: #d2d2d2;
        font-size: 36px;
        font-weight: 600;
        margin-bottom: 0;
    }
    .about-title h2 {
        font-size: 46px;
    }
    .breadcrumb-area .breadcrumb .breadcrumb-item {
        display: flex;
        align-items: center;
        font-size: 16px !important;
    }
    .breadcrumb-area .breadcrumb .breadcrumb-item + .breadcrumb-item::before {
        content: "/";
        padding: 0 8px;
        color: #6c757d;
    }
    .breadcrumb-area .breadcrumb .breadcrumb-item a {
        color: #3aafdd;
        text-decoration: none;
        transition: color 0.3s ease;
        font-size: 16px !important;
    }
    .breadcrumb-area .breadcrumb .breadcrumb-item a:hover {
        color: #2d8cb3;
    }
    .breadcrumb-area .breadcrumb .breadcrumb-item.active {
        color: #6c757d;
        font-size: 16px !important;
    }
</style> 