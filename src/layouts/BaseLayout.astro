---
import '../styles/global.css';
import TopBar from '../components/TopBar.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import FloatingActions from '../components/FloatingActions.astro';
import { SITE } from '../data/site';
import { getImage } from 'astro:assets';
import ogDefault from '../assets/img/hero-ortodoncia-temuco.jpg';
import type { ImageMetadata } from 'astro';

interface Props {
  title: string;
  description: string;
  image?: ImageMetadata;
  type?: 'website' | 'article';
  noindex?: boolean;
  schema?: Record<string, unknown>[];
  breadcrumbs?: { name: string; url: string }[];
}

const { title, description, image = ogDefault, type = 'website', noindex = false, schema = [], breadcrumbs } = Astro.props;
const canonical = new URL(Astro.url.pathname, SITE.url).href;
const og = await getImage({ src: image, width: 1200, height: 630, format: 'jpg', fit: 'cover' });
const ogUrl = new URL(og.src, SITE.url).href;
const fullTitle = title.toLowerCase().includes(SITE.name.toLowerCase()) || title.length + SITE.name.length + 3 > 66 ? title : `${title} | ${SITE.name}`;

// Datos estructurados globales: clínica dental (LocalBusiness) + WebSite
const business = {
  '@context': 'https://schema.org',
  '@type': ['Dentist', 'MedicalClinic'],
  '@id': `${SITE.url}/#clinica`,
  name: SITE.name,
  alternateName: 'Ortodoncia para Todos Temuco',
  slogan: SITE.slogan,
  url: SITE.url + '/',
  logo: new URL('/icon-512.png', SITE.url).href,
  image: ogUrl,
  email: SITE.email,
  telephone: SITE.phones.map((p) => p.href.replace('tel:', '')),
  priceRange: '$$',
  currenciesAccepted: 'CLP',
  medicalSpecialty: ['Orthodontic', 'Dentistry'],
  address: {
    '@type': 'PostalAddress',
    streetAddress: SITE.address,
    addressLocality: SITE.city,
    addressRegion: SITE.region,
    addressCountry: 'CL',
  },
  hasMap: SITE.mapsUrl,
  areaServed: [{ '@type': 'City', name: 'Temuco' }, { '@type': 'City', name: 'Padre Las Casas' }, { '@type': 'AdministrativeArea', name: 'Región de La Araucanía' }],
  sameAs: [SITE.social.instagram, SITE.social.facebook],
  potentialAction: { '@type': 'ReserveAction', target: SITE.agendaUrl, name: 'Agendar cita' },
};
const website = {
  '@context': 'https://schema.org',
  '@type': 'WebSite',
  '@id': `${SITE.url}/#website`,
  url: SITE.url + '/',
  name: SITE.name,
  inLanguage: 'es-CL',
  publisher: { '@id': `${SITE.url}/#clinica` },
};
const crumbs = breadcrumbs
  ? {
      '@context': 'https://schema.org',
      '@type': 'BreadcrumbList',
      itemListElement: [{ name: 'Inicio', url: '/' }, ...breadcrumbs].map((b, i) => ({
        '@type': 'ListItem',
        position: i + 1,
        name: b.name,
        item: new URL(b.url, SITE.url).href,
      })),
    }
  : null;
const allSchema = [business, website, ...(crumbs ? [crumbs] : []), ...schema];
---
<!doctype html>
<html lang="es-CL" class="no-js">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{fullTitle}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    <meta name="robots" content={noindex ? 'noindex, follow' : 'index, follow, max-image-preview:large'} />
    <meta name="theme-color" content="#0A284E" />
    <meta name="geo.region" content="CL-AR" />
    <meta name="geo.placename" content="Temuco" />

    <link rel="icon" href="/favicon.ico" sizes="32x32" />
    <link rel="icon" type="image/png" href="/favicon.png" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <link rel="sitemap" href="/sitemap-index.xml" />
    <link rel="manifest" href="/site.webmanifest" />

    <meta property="og:type" content={type} />
    <meta property="og:locale" content="es_CL" />
    <meta property="og:site_name" content={SITE.name} />
    <meta property="og:title" content={fullTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={ogUrl} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={fullTitle} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogUrl} />

    <script is:inline>document.documentElement.classList.remove('no-js');</script>
    {allSchema.map((s) => <script type="application/ld+json" set:html={JSON.stringify(s)} />)}
    <slot name="head" />
  </head>
  <body>
    <a class="skip-link" href="#contenido">Saltar al contenido</a>
    <TopBar />
    <Header />
    <main id="contenido">
      <slot />
    </main>
    <Footer />
    <FloatingActions />

    <script>
      // Animaciones de aparición al hacer scroll
      const els = document.querySelectorAll('[data-reveal]');
      if ('IntersectionObserver' in window) {
        const io = new IntersectionObserver(
          (entries) => entries.forEach((e) => { if (e.isIntersecting) { e.target.classList.add('is-in'); io.unobserve(e.target); } }),
          { rootMargin: '0px 0px -8% 0px', threshold: 0.08 }
        );
        els.forEach((el) => io.observe(el));
      } else els.forEach((el) => el.classList.add('is-in'));
    </script>
  </body>
</html>
